PORT=5000

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/chust_one?schema=public"

# Generate a strong random value for production, e.g.: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN="https://chustone.uz,https://www.chustone.uz"

# Used to build absolute URLs for uploaded files (no trailing slash)
PUBLIC_BASE_URL="https://chustone.uz"

# Used only by `npm run db:seed` to create/update the initial admin account
ADMIN_PHONE="+998990000000"
ADMIN_EMAIL="admin@chustone.uz"
ADMIN_PASSWORD="change-me-before-production"

# Paynet merchant API (server-to-server; Paynet calls /api/v1/payments/paynet
# with these Basic Auth credentials). Values come from Paynet's integration form.
PAYNET_LOGIN="replace-with-paynet-login"
PAYNET_PASSWORD="replace-with-paynet-password"
PAYNET_SERVICE_ID="replace-with-assigned-service-id"
