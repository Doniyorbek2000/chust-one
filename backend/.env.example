PORT=5000

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/chust_one?schema=public"

# Generate a strong random value for production, e.g.: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN="https://chustone.uz,https://www.chustone.uz"

# Used to build absolute URLs for uploaded files (no trailing slash)
PUBLIC_BASE_URL="https://chustone.uz"

# Used only by `npm run db:seed` to create/update the initial admin account
ADMIN_PHONE="+998990000000"
ADMIN_EMAIL="admin@chustone.uz"
ADMIN_PASSWORD="change-me-before-production"

# Paynet merchant API (server-to-server; Paynet calls /api/v1/payments/paynet
# with these Basic Auth credentials). Values come from Paynet's integration form.
PAYNET_LOGIN="replace-with-paynet-login"
PAYNET_PASSWORD="replace-with-paynet-password"
PAYNET_SERVICE_ID="replace-with-assigned-service-id"

# Click merchant API (server-to-server; Click calls /api/v1/payments/click/prepare
# and /complete). Values come from merchant.click.uz — Service ID / Merchant ID.
CLICK_SERVICE_ID="replace-with-click-service-id"
CLICK_MERCHANT_ID="replace-with-click-merchant-id"
CLICK_SECRET_KEY="replace-with-click-secret-key"
CLICK_MERCHANT_USER_ID="replace-with-click-merchant-user-id"

# Eskiz.uz SMS gateway (https://notify.eskiz.uz/api) — used to send the
# 4-digit phone-verification code for the mobile app's login/registration.
ESKIZ_EMAIL="replace-with-eskiz-account-email"
ESKIZ_PASSWORD="replace-with-eskiz-account-password"
# Sender name ("nickname") approved under the Eskiz contract. The shared
# "4546" sender only works with ESKIZ_TEST_MODE=true (fixed test text).
# The OTP text (buildOtpMessage in src/sms.ts) must match an approved template
# in the Eskiz dashboard, otherwise Eskiz rejects the send.
ESKIZ_SENDER="4546"
ESKIZ_TEST_MODE="false"
# Max OTP SMS the whole service may send per hour (spend/abuse circuit breaker)
OTP_GLOBAL_HOURLY_LIMIT="1000"

# App Store / Play review account: this phone receives a fixed code and no SMS
# is sent (reviewers can't get real SMS). Leave both empty to disable.
OTP_DEMO_PHONE="+998900000001"
OTP_DEMO_CODE="1234"
